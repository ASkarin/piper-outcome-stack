# Copy to infra/container/.env, replace every CHANGE_ME value, and chmod 0600.
PIPER_IMAGE=ghcr.io/askarin/piper-outcome-stack-env:CHANGE_ME
PIPER_WORKSPACE_HOST=/CHANGE_ME/piper-outcome-stack/workspace
PIPER_SSH_HOST_KEYS_HOST=/CHANGE_ME/piper-outcome-stack/ssh-host-keys
PIPER_AUTH_KEYS_HOST=/CHANGE_ME/piper-outcome-stack/authorized-keys
PIPER_SSH_BIND=0.0.0.0:22022

PIPER_ADMIN_USER=CHANGE_ME
PIPER_ADMIN_UID=CHANGE_ME
PIPER_COLLAB_USER=CHANGE_ME
PIPER_COLLAB_UID=CHANGE_ME
PIPER_GROUP_GID=CHANGE_ME
