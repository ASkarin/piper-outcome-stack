#!/usr/bin/env bash
set -euo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly ENV_FILE="${SCRIPT_DIR}/.env"
readonly COMPOSE_FILE="${SCRIPT_DIR}/compose.yaml"

fail() {
    echo "piper-compose: $*" >&2
    exit 2
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail "required command is missing: $1"
}

require_var() {
    local name="$1"
    test -n "${!name:-}" || fail "required variable ${name} is empty"
    [[ "${!name}" != *CHANGE_ME* ]] || fail "required variable ${name} still contains CHANGE_ME"
}

validate_host_path() {
    local name="$1"
    local value="${!name}"
    [[ "${value}" == /* ]] || fail "${name} must be an absolute host path"
    [[ "${value}" != "/" ]] || fail "${name} must not be the host root"
    [[ ! -L "${value}" ]] || fail "${name} must not be a symbolic link"
    [[ -d "${value}" ]] || fail "${name} must name an existing host directory"
}

validate_user_name() {
    local name="$1"
    local value="${!name}"
    [[ "${value}" =~ ^[a-z_][a-z0-9_-]{0,30}$ ]] \
        || fail "${name} is not a valid Linux user name"
}

validate_id() {
    local name="$1"
    local value="${!name}"
    [[ "${value}" =~ ^[0-9]+$ ]] && (( value >= 1000 && value <= 60000 )) \
        || fail "${name} must be an integer from 1000 through 60000"
}

validate_runtime_inputs() {
    local key_file
    local key_path
    local ssh_port

    for variable in PIPER_WORKSPACE_HOST PIPER_SSH_HOST_KEYS_HOST PIPER_AUTH_KEYS_HOST; do
        validate_host_path "${variable}"
    done
    for variable in PIPER_ADMIN_USER PIPER_COLLAB_USER; do
        validate_user_name "${variable}"
    done
    for variable in PIPER_ADMIN_UID PIPER_COLLAB_UID PIPER_GROUP_GID; do
        validate_id "${variable}"
    done

    [[ "${PIPER_ADMIN_USER}" != "${PIPER_COLLAB_USER}" ]] \
        || fail "admin and collaborator user names must differ"
    [[ "${PIPER_ADMIN_UID}" != "${PIPER_COLLAB_UID}" ]] \
        || fail "admin and collaborator UIDs must differ"
    [[ "${PIPER_GROUP_GID}" != "${PIPER_ADMIN_UID}" && "${PIPER_GROUP_GID}" != "${PIPER_COLLAB_UID}" ]] \
        || fail "project GID must differ from both private user IDs"
    for key_file in admin_authorized_keys collaborator_authorized_keys; do
        key_path="${PIPER_AUTH_KEYS_HOST}/${key_file}"
        [[ ! -L "${key_path}" && -f "${key_path}" && -s "${key_path}" ]] \
            || fail "missing regular non-empty public-key file: ${key_path}"
    done
    [[ "${PIPER_SSH_BIND}" =~ ^[^[:space:]]+:[0-9]{1,5}$ ]] \
        || fail "PIPER_SSH_BIND must have the form address:port"
    ssh_port="${PIPER_SSH_BIND##*:}"
    (( ssh_port >= 1 && ssh_port <= 65535 )) \
        || fail "SSH port must be from 1 through 65535"
}

[[ -f "${ENV_FILE}" ]] || fail "copy env.example to ${ENV_FILE} and fill every value"

if stat --version >/dev/null 2>&1; then
    mode="$(stat -c '%a' "${ENV_FILE}")"
    [[ "${mode}" == "600" ]] || fail "${ENV_FILE} must have mode 0600, found ${mode}"
fi

set -a
source "${ENV_FILE}"
set +a

for variable in \
    PIPER_IMAGE \
    PIPER_WORKSPACE_HOST \
    PIPER_SSH_HOST_KEYS_HOST \
    PIPER_AUTH_KEYS_HOST \
    PIPER_SSH_BIND \
    PIPER_ADMIN_USER \
    PIPER_ADMIN_UID \
    PIPER_COLLAB_USER \
    PIPER_COLLAB_UID \
    PIPER_GROUP_GID
do
    require_var "${variable}"
done

action="${1:-config}"
shift || true

case "${action}" in
    config)
        validate_runtime_inputs
        require_command docker
        exec docker compose --env-file "${ENV_FILE}" -f "${COMPOSE_FILE}" config "$@"
        ;;
    pull)
        validate_runtime_inputs
        require_command docker
        exec docker compose --env-file "${ENV_FILE}" -f "${COMPOSE_FILE}" pull "$@"
        ;;
    up)
        validate_runtime_inputs
        require_command docker
        exec docker compose --env-file "${ENV_FILE}" -f "${COMPOSE_FILE}" up -d "$@"
        ;;
    restart)
        require_command docker
        exec docker compose --env-file "${ENV_FILE}" -f "${COMPOSE_FILE}" restart "$@"
        ;;
    recreate)
        validate_runtime_inputs
        require_command docker
        exec docker compose \
            --env-file "${ENV_FILE}" \
            -f "${COMPOSE_FILE}" \
            up -d --force-recreate "$@"
        ;;
    down | ps | logs)
        require_command docker
        exec docker compose --env-file "${ENV_FILE}" -f "${COMPOSE_FILE}" "${action}" "$@"
        ;;
    doctor)
        require_command docker
        exec docker exec \
            --user "${PIPER_ADMIN_USER}" \
            --workdir /workspace/projects/piper-outcome-stack \
            piper-outcome-stack-training \
            /workspace/piper/bin/piper-env-doctor \
            --repo /workspace/projects/piper-outcome-stack \
            --json \
            "$@"
        ;;
    *)
        fail \
            "unsupported action ${action}; use config, pull, up, restart, recreate, down, ps, logs, or doctor"
        ;;
esac
