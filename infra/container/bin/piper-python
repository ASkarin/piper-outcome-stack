#!/workspace/piper/python-env/bin/python
from __future__ import annotations

import fcntl
import json
import os
import pwd
import subprocess
import sys
import uuid
from pathlib import Path

for candidate in (
    Path("/workspace/piper/lib"),
    Path("/usr/local/lib/piper-container"),
    Path(__file__).resolve().parents[1] / "lib",
):
    if candidate.is_dir():
        sys.path.insert(0, str(candidate))
        break

from piper_container_common import (  # noqa: E402
    PIPER_ROOT,
    PYTHON_HISTORY_ROOT,
    SHARED_PYTHON_ENV,
    PiperContainerError,
    load_runtime_config,
    sha256_bytes,
    utc_now,
)


def freeze_packages() -> str:
    try:
        result = subprocess.run(
            [sys.executable, "-m", "pip", "freeze", "--all"],
            check=True,
            capture_output=True,
            text=True,
        )
    except (OSError, subprocess.CalledProcessError) as exc:
        raise PiperContainerError(f"cannot snapshot the shared Python environment: {exc}") from exc
    return result.stdout.rstrip("\n") + "\n"


def write_snapshot(packages: str, *, operation_id: str) -> tuple[Path, str]:
    snapshot_root = PYTHON_HISTORY_ROOT / "snapshots"
    snapshot_root.mkdir(mode=0o750, parents=True, exist_ok=True)
    snapshot = snapshot_root / f"{operation_id}.txt"
    with snapshot.open("x", encoding="utf-8", newline="\n") as stream:
        stream.write(packages)
        stream.flush()
        os.fsync(stream.fileno())
    snapshot.chmod(0o640)
    return snapshot, sha256_bytes(packages.encode("utf-8"))


def append_audit(record: dict[str, object]) -> None:
    audit_path = PYTHON_HISTORY_ROOT / "operations.jsonl"
    descriptor = os.open(
        audit_path,
        os.O_APPEND | os.O_CREAT | os.O_WRONLY,
        0o640,
    )
    try:
        payload = json.dumps(
            record,
            ensure_ascii=False,
            sort_keys=True,
            separators=(",", ":"),
        )
        os.write(descriptor, payload.encode("utf-8") + b"\n")
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def ensure_shared_interpreter() -> Path:
    executable = Path(os.path.abspath(sys.executable))
    root = Path(os.path.abspath(SHARED_PYTHON_ENV))
    if not executable.is_file():
        raise PiperContainerError(f"shared Python interpreter is unavailable: {executable}")
    if not executable.is_relative_to(root):
        raise PiperContainerError(f"piper-python must run from {SHARED_PYTHON_ENV}, found {executable}")
    return executable


def run_mutation(action: str, arguments: list[str], user: str) -> int:
    if not arguments:
        raise PiperContainerError(f"piper-python {action} requires at least one package or option")

    lock_path = PIPER_ROOT / "locks" / "python-environment.lock"
    lock_path.parent.mkdir(mode=0o770, parents=True, exist_ok=True)
    with lock_path.open("a+", encoding="utf-8") as lock_stream:
        fcntl.flock(lock_stream.fileno(), fcntl.LOCK_EX)
        before = freeze_packages()
        command = [sys.executable, "-m", "pip", action]
        if action == "uninstall" and "--yes" not in arguments and "-y" not in arguments:
            command.append("--yes")
        command.extend(arguments)
        completed = subprocess.run(command, check=False)
        after = freeze_packages()

        timestamp = utc_now()
        operation_id = (
            timestamp.replace(":", "").replace("-", "").replace(".", "")
            + f"-{uuid.uuid4().hex[:8]}-{action}"
        )
        snapshot, after_hash = write_snapshot(after, operation_id=operation_id)
        append_audit(
            {
                "schema_version": 1,
                "operation_id": operation_id,
                "timestamp_utc": timestamp,
                "operator": user,
                "action": action,
                "requested": arguments,
                "exit_code": completed.returncode,
                "status": "succeeded" if completed.returncode == 0 else "failed",
                "python_executable": os.path.abspath(sys.executable),
                "python_version": sys.version.split()[0],
                "before_freeze_sha256": sha256_bytes(before.encode("utf-8")),
                "after_freeze_sha256": after_hash,
                "resolved_packages": [line for line in after.splitlines() if line.strip()],
                "snapshot": str(snapshot),
            }
        )
        return completed.returncode


def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] not in {"install", "uninstall", "list", "snapshot"}:
        print(
            "usage: piper-python <install|uninstall|list|snapshot> [packages-or-options...]",
            file=sys.stderr,
        )
        return 2

    try:
        ensure_shared_interpreter()
        runtime = load_runtime_config()
        user = pwd.getpwuid(os.getuid()).pw_name
        if user not in {runtime["admin_user"], runtime["collaborator_user"]}:
            raise PiperContainerError(f"user {user} is not an PiPER project member")

        action = sys.argv[1]
        arguments = sys.argv[2:]
        if action == "list":
            return subprocess.run(
                [sys.executable, "-m", "pip", "list", *arguments],
                check=False,
            ).returncode
        if user != runtime["admin_user"]:
            raise PiperContainerError(
                f"only the project administrator ({runtime['admin_user']}) "
                f"may run piper-python {action}"
            )
        if action == "snapshot":
            if arguments:
                raise PiperContainerError("piper-python snapshot does not accept arguments")
            packages = freeze_packages()
            timestamp = utc_now()
            operation_id = (
                timestamp.replace(":", "").replace("-", "").replace(".", "")
                + f"-{uuid.uuid4().hex[:8]}-snapshot"
            )
            snapshot, packages_hash = write_snapshot(packages, operation_id=operation_id)
            append_audit(
                {
                    "schema_version": 1,
                    "operation_id": operation_id,
                    "timestamp_utc": timestamp,
                    "operator": user,
                    "action": "snapshot",
                    "status": "succeeded",
                    "exit_code": 0,
                    "python_executable": os.path.abspath(sys.executable),
                    "python_version": sys.version.split()[0],
                    "after_freeze_sha256": packages_hash,
                    "resolved_packages": [line for line in packages.splitlines() if line.strip()],
                    "snapshot": str(snapshot),
                }
            )
            print(snapshot)
            return 0
        return run_mutation(action, arguments, user)
    except (PiperContainerError, OSError, subprocess.SubprocessError) as exc:
        print(f"piper-python: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
