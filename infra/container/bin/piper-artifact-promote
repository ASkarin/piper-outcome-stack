#!/workspace/piper/python-env/bin/python
from __future__ import annotations

import argparse
import grp
import os
import shutil
import sys
import uuid
from pathlib import Path

for candidate in (
    Path("/workspace/piper/lib"),
    Path("/usr/local/lib/piper-container"),
    Path(__file__).resolve().parents[1] / "lib",
):
    if candidate.is_dir():
        sys.path.insert(0, str(candidate))
        break

from piper_container_common import (  # noqa: E402
    PIPER_ROOT,
    ARTIFACT_MANIFEST_NAME,
    PiperContainerError,
    ensure_under,
    file_inventory,
    inventory_identity,
    load_json,
    load_runtime_config,
    validate_repo_id,
    validate_revision,
)


def set_release_ownership(root: Path, uid: int, gid: int) -> None:
    for path in [root, *root.rglob("*")]:
        if path.is_symlink():
            raise PiperContainerError(f"symbolic link appeared during promotion: {path}")
        os.chown(path, uid, gid)
        path.chmod(0o2750 if path.is_dir() else 0o640)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Promote a verified artifact into a read-only release"
    )
    parser.add_argument("--manifest", type=Path, required=True)
    args = parser.parse_args()

    temporary: Path | None = None
    try:
        if os.geteuid() != 0:
            raise PiperContainerError("artifact promotion must run through sudo")

        runtime = load_runtime_config()
        group = grp.getgrnam(runtime["group_name"])
        staging_root = PIPER_ROOT / "staging"
        manifest_path = ensure_under(args.manifest.resolve(strict=True), staging_root)
        if manifest_path.name != ARTIFACT_MANIFEST_NAME:
            raise PiperContainerError(f"manifest must be named {ARTIFACT_MANIFEST_NAME}")

        source_root = manifest_path.parent
        manifest = load_json(manifest_path)
        if manifest.get("schema_version") != 1:
            raise PiperContainerError("unsupported artifact manifest schema")
        artifact_type = manifest.get("artifact_type")
        if artifact_type not in {"model", "dataset"}:
            raise PiperContainerError("artifact type must be model or dataset")
        repo_id = validate_repo_id(str(manifest.get("repo_id", "")))
        revision = validate_revision(str(manifest.get("revision", "")))
        if manifest.get("source_endpoint") != "https://hf-mirror.com":
            raise PiperContainerError("artifact source endpoint is not approved")

        actual_files = file_inventory(source_root)
        if actual_files != manifest.get("files"):
            raise PiperContainerError("artifact file inventory or SHA-256 values do not match")
        if inventory_identity(actual_files) != manifest.get("content_sha256"):
            raise PiperContainerError("artifact content identity does not match")

        release_kind = f"{artifact_type}s"
        release_parent = PIPER_ROOT / "releases" / release_kind
        destination = release_parent / f"{repo_id.replace('/', '--')}@{revision}"
        if destination.exists():
            raise PiperContainerError(
                f"release already exists and cannot be overwritten: {destination}"
            )

        temporary = release_parent / f".{destination.name}.tmp-{uuid.uuid4().hex}"
        shutil.copytree(source_root, temporary, symlinks=False)
        copied_manifest = load_json(temporary / ARTIFACT_MANIFEST_NAME)
        copied_files = file_inventory(temporary)
        if copied_files != copied_manifest.get("files"):
            raise PiperContainerError("copied release failed post-copy verification")
        if inventory_identity(copied_files) != copied_manifest.get("content_sha256"):
            raise PiperContainerError("copied release identity failed verification")

        set_release_ownership(temporary, 0, group.gr_gid)
        temporary.replace(destination)
        temporary = None
        print(destination)
        return 0
    except (PiperContainerError, KeyError, OSError, ValueError) as exc:
        print(f"piper-artifact-promote: {exc}", file=sys.stderr)
        return 2
    finally:
        if temporary is not None and temporary.exists():
            resolved = temporary.resolve(strict=False)
            releases = (PIPER_ROOT / "releases").resolve(strict=False)
            if resolved.is_relative_to(releases) and resolved.name.startswith("."):
                shutil.rmtree(resolved)


if __name__ == "__main__":
    raise SystemExit(main())
