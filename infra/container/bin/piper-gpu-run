#!/workspace/piper/python-env/bin/python
from __future__ import annotations

import argparse
import fcntl
import json
import os
import pwd
import shutil
import signal
import subprocess
import sys
import uuid
from contextlib import ExitStack
from pathlib import Path

for candidate in (
    Path(__file__).resolve().parents[1] / "lib",
    Path("/workspace/piper/lib"),
    Path("/usr/local/lib/piper-container"),
):
    if (candidate / "piper_container_common.py").is_file():
        sys.path.insert(0, str(candidate))
        break

from piper_container_common import (  # noqa: E402
    PIPER_ROOT,
    PiperContainerError,
    atomic_write_json,
    git_state,
    gpu_inventory,
    load_runtime_config,
    manifest_hash,
    python_environment,
    selected_python,
    source_record,
    utc_now,
    validate_run_id,
)


def parse_gpus(value: str, inventory: list[dict[str, object]]) -> list[dict[str, object]]:
    requested = [item.strip() for item in value.split(",") if item.strip()]
    lookup = {str(gpu[key]): gpu for gpu in inventory for key in ("index", "uuid")}
    if not requested:
        raise PiperContainerError("at least one GPU index or UUID is required")
    unknown = [item for item in requested if item not in lookup]
    if unknown:
        raise PiperContainerError(f"unknown GPUs: {', '.join(unknown)}")
    selected = [lookup[item] for item in requested]
    if len({gpu["uuid"] for gpu in selected}) != len(selected):
        raise PiperContainerError("GPU selections must not be repeated")
    return selected


def prepare_command(command: list[str], python: str) -> list[str]:
    """Launch Python and Python console scripts with the recorded interpreter."""
    first = Path(command[0]).name
    if first in {"python", "python3", "python3.12"}:
        return [python, *command[1:]]
    if first == "torchrun":
        return [python, "-m", "torch.distributed.run", *command[1:]]
    search_path = str(Path(python).parent) + os.pathsep + os.environ.get("PATH", "")
    executable = shutil.which(command[0], path=search_path)
    if executable:
        with Path(executable).open("rb") as stream:
            shebang = stream.readline(256)
        if shebang.startswith(b"#!") and b"python" in shebang:
            return [python, executable, *command[1:]]
    return command


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Run a development or formal command under GPU locks"
    )
    parser.add_argument("--gpus", required=True, help="comma-separated GPU indexes or UUIDs")
    parser.add_argument("--run-id", help="default: timestamp and random suffix")
    parser.add_argument("--repo", type=Path, default=Path.cwd())
    parser.add_argument("--python", help="default: active venv or PATH Python")
    parser.add_argument(
        "--formal", action="store_true", help="require committed code and versioned data"
    )
    parser.add_argument("--config", type=Path)
    parser.add_argument("--dataset-manifest", type=Path)
    parser.add_argument("--model-manifest", type=Path)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    if args.command and args.command[0] == "--":
        args.command = args.command[1:]
    if not args.command:
        parser.error("a command is required after --")

    run_dir = None
    started = False
    exit_code = 3
    error = None
    try:
        run_id = validate_run_id(
            args.run_id
            or (
                ("formal-" if args.formal else "dev-")
                + utc_now().replace(":", "").replace(".", "-")
                + "-"
                + uuid.uuid4().hex[:8]
            )
        )
        runtime = load_runtime_config()
        user = pwd.getpwuid(os.getuid()).pw_name
        if user not in {runtime["admin_user"], runtime["collaborator_user"]}:
            raise PiperContainerError(f"user {user} is not a PiPER project member")
        repo = args.repo.resolve(strict=True)
        state = git_state(repo)
        if args.formal and state["dirty"]:
            raise PiperContainerError(
                "formal runs require committed code; development runs allow edits"
            )
        if args.formal and (args.config is None or args.dataset_manifest is None):
            raise PiperContainerError("formal runs require --config and --dataset-manifest")
        selected = parse_gpus(args.gpus, gpu_inventory())
        python = selected_python(args.python)
        identity, packages = python_environment(python)
        command = prepare_command(args.command, python)
        manifests = {
            name: value.resolve(strict=True)
            for name, value in (("dataset", args.dataset_manifest), ("model", args.model_manifest))
            if value is not None
        }
        config = args.config.resolve(strict=True) if args.config else None
        run_dir = PIPER_ROOT / "runs" / user / run_id
        if run_dir.exists():
            raise PiperContainerError(f"run directory already exists: {run_dir}")

        with ExitStack() as stack:
            for gpu in sorted(selected, key=lambda item: str(item["uuid"])):
                lock = stack.enter_context(
                    (PIPER_ROOT / "locks" / f"{gpu['uuid']}.lock").open("a+")
                )
                try:
                    fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError as exc:
                    raise PiperContainerError(f"GPU is already reserved: {gpu['uuid']}") from exc
                lock.seek(0)
                lock.truncate()
                json.dump(
                    {
                        "run_id": run_id,
                        "user": user,
                        "pid": os.getpid(),
                        "gpu_uuid": gpu["uuid"],
                        "acquired_at_utc": utc_now(),
                    },
                    lock,
                )
                lock.flush()

            run_dir.mkdir(mode=0o750)
            started = True
            print(f"run directory: {run_dir}", flush=True)
            for name in ("wandb", "tensorboard"):
                (run_dir / name).mkdir()
            (run_dir / "python-packages.txt").write_text(packages)
            source_record(repo, run_dir)
            config_record = None
            if config:
                copied = run_dir / ("config.resolved" + "".join(config.suffixes))
                shutil.copyfile(config, copied)
                config_record = {
                    "source": str(config),
                    "copied": copied.name,
                    "sha256": manifest_hash(copied),
                }
            manifest_records = {}
            for name, path in manifests.items():
                copied = run_dir / f"{name}-manifest.json"
                shutil.copyfile(path, copied)
                manifest_records[name] = {
                    "path": str(path),
                    "copied": copied.name,
                    "sha256": manifest_hash(copied),
                }
            identity["packages_file"] = "python-packages.txt"
            child_environment = os.environ.copy()
            child_environment["PATH"] = (
                str(Path(python).parent) + os.pathsep + child_environment.get("PATH", "")
            )
            child_environment["VIRTUAL_ENV"] = identity["prefix"]
            child_environment.setdefault("WANDB_MODE", "offline")
            child_environment.update(
                {
                    "PIPER_RUN_ID": run_id,
                    "PIPER_RUN_DIR": str(run_dir),
                    "CUDA_VISIBLE_DEVICES": ",".join(str(gpu["uuid"]) for gpu in selected),
                    "WANDB_DIR": str(run_dir / "wandb"),
                    "TENSORBOARD_LOG_DIR": str(run_dir / "tensorboard"),
                }
            )
            atomic_write_json(
                run_dir / "environment.json",
                {
                    "schema_version": 3,
                    "run_id": run_id,
                    "mode": "formal" if args.formal else "development",
                    "user": user,
                    "started_at_utc": utc_now(),
                    "command": command,
                    "requested_command": args.command,
                    "working_directory": str(repo),
                    "git": state,
                    "python": identity,
                    "gpus": selected,
                    "config": config_record,
                    "manifests": manifest_records,
                    "network": {
                        key: child_environment.get(key)
                        for key in ("HF_ENDPOINT", "HF_HUB_OFFLINE", "WANDB_MODE")
                    },
                },
            )
            with (run_dir / "output.log").open("wb") as log:
                process = subprocess.Popen(
                    command,
                    cwd=repo,
                    env=child_environment,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    start_new_session=True,
                )

                def forward(signum: int, _frame: object) -> None:
                    if process.poll() is None:
                        os.killpg(process.pid, signum)

                previous = {
                    sig: signal.signal(sig, forward) for sig in (signal.SIGINT, signal.SIGTERM)
                }
                try:
                    for line in iter(process.stdout.readline, b""):
                        log.write(line)
                        log.flush()
                        sys.stdout.buffer.write(line)
                        sys.stdout.buffer.flush()
                    code = process.wait()
                    exit_code = code if code >= 0 else 128 - code
                finally:
                    # Keep the GPU locks until the child process group is reaped,
                    # including output/log failures and KeyboardInterrupt.
                    try:
                        if process.poll() is None:
                            try:
                                os.killpg(process.pid, signal.SIGTERM)
                            except ProcessLookupError:
                                pass
                            try:
                                process.wait(timeout=5)
                            except subprocess.TimeoutExpired:
                                try:
                                    os.killpg(process.pid, signal.SIGKILL)
                                except ProcessLookupError:
                                    pass
                                process.wait()
                    finally:
                        if process.stdout is not None:
                            process.stdout.close()
                    for sig, handler in previous.items():
                        signal.signal(sig, handler)
            return exit_code
    except (PiperContainerError, OSError, subprocess.SubprocessError, ValueError) as exc:
        error = str(exc)
        print(f"piper-gpu-run: {exc}", file=sys.stderr)
        return exit_code
    finally:
        if started:
            atomic_write_json(
                run_dir / "summary.json",
                {
                    "schema_version": 2,
                    "run_id": run_dir.name,
                    "status": "succeeded" if exit_code == 0 else "failed",
                    "exit_code": exit_code,
                    "stop_reason": error
                    or (f"command exited with status {exit_code}" if exit_code else None),
                    "ended_at_utc": utc_now(),
                    "environment_file": "environment.json",
                    "python_packages": "python-packages.txt",
                    "log": "output.log",
                },
            )


if __name__ == "__main__":
    raise SystemExit(main())
