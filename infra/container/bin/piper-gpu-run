#!/workspace/piper/python-env/bin/python
from __future__ import annotations

import argparse
import fcntl
import json
import os
import pwd
import shutil
import signal
import subprocess
import sys
from contextlib import ExitStack
from pathlib import Path

for candidate in (
    Path("/workspace/piper/lib"),
    Path("/usr/local/lib/piper-container"),
    Path(__file__).resolve().parents[1] / "lib",
):
    if candidate.is_dir():
        sys.path.insert(0, str(candidate))
        break

from piper_container_common import (  # noqa: E402
    PIPER_ROOT,
    PiperContainerError,
    atomic_write_json,
    git_state,
    gpu_inventory,
    load_runtime_config,
    manifest_hash,
    utc_now,
    validate_run_id,
)


def parse_gpus(value: str, inventory: list[dict[str, object]]) -> list[dict[str, object]]:
    requested = [item.strip() for item in value.split(",") if item.strip()]
    if not requested:
        raise PiperContainerError("at least one GPU UUID is required")
    if len(set(requested)) != len(requested):
        raise PiperContainerError("GPU UUIDs must not be repeated")
    by_uuid = {str(gpu["uuid"]): gpu for gpu in inventory}
    unknown = [uuid for uuid in requested if uuid not in by_uuid]
    if unknown:
        raise PiperContainerError(f"unknown GPU UUIDs: {', '.join(unknown)}")
    return [by_uuid[uuid] for uuid in requested]


def main() -> int:
    parser = argparse.ArgumentParser(description="Run a formal command under cooperative GPU locks")
    parser.add_argument("--gpus", required=True, help="comma-separated nvidia-smi GPU UUIDs")
    parser.add_argument("--run-id", required=True)
    parser.add_argument("--repo", type=Path, default=Path.cwd())
    parser.add_argument("--config", type=Path)
    parser.add_argument("--dataset-manifest", type=Path)
    parser.add_argument("--model-manifest", type=Path)
    parser.add_argument("--allow-dirty", action="store_true")
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()

    if args.command and args.command[0] == "--":
        args.command = args.command[1:]
    if not args.command:
        parser.error("a command is required after --")

    try:
        run_id = validate_run_id(args.run_id)
        runtime = load_runtime_config()
        user = pwd.getpwuid(os.getuid()).pw_name
        if user not in {runtime["admin_user"], runtime["collaborator_user"]}:
            raise PiperContainerError(f"user {user} is not an PiPER project member")
        state = git_state(args.repo.resolve(strict=True))
        if state["dirty"] and not args.allow_dirty:
            raise PiperContainerError("formal runs require a clean Git worktree")
        selected_gpus = parse_gpus(args.gpus, gpu_inventory())
    except (PiperContainerError, OSError) as exc:
        print(f"piper-gpu-run: {exc}", file=sys.stderr)
        return 2

    manifest_paths: dict[str, Path] = {}
    for name, value in (
        ("dataset", args.dataset_manifest),
        ("model", args.model_manifest),
    ):
        if value is not None:
            try:
                manifest_paths[name] = value.resolve(strict=True)
            except OSError as exc:
                print(f"piper-gpu-run: cannot resolve {name} manifest: {exc}", file=sys.stderr)
                return 2

    run_dir = PIPER_ROOT / "runs" / user / run_id
    if run_dir.exists():
        print(f"piper-gpu-run: run directory already exists: {run_dir}", file=sys.stderr)
        return 4

    locks_dir = PIPER_ROOT / "locks"
    lock_streams = []
    try:
        with ExitStack() as stack:
            for gpu in sorted(selected_gpus, key=lambda item: str(item["uuid"])):
                safe_uuid = str(gpu["uuid"]).replace("/", "_")
                lock_path = locks_dir / f"{safe_uuid}.lock"
                stream = stack.enter_context(lock_path.open("a+", encoding="utf-8"))
                try:
                    fcntl.flock(stream.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError as exc:
                    raise PiperContainerError(f"GPU is already reserved: {gpu['uuid']}") from exc
                stream.seek(0)
                stream.truncate()
                stream.write(
                    json.dumps(
                        {
                            "run_id": run_id,
                            "user": user,
                            "pid": os.getpid(),
                            "gpu_uuid": gpu["uuid"],
                            "acquired_at_utc": utc_now(),
                        },
                        sort_keys=True,
                    )
                    + "\n"
                )
                stream.flush()
                os.fsync(stream.fileno())
                lock_streams.append(stream)

            run_dir.mkdir(mode=0o750, parents=False)
            (run_dir / "wandb").mkdir()
            (run_dir / "tensorboard").mkdir()
            (run_dir / "metrics.jsonl").touch(exist_ok=False)
            (run_dir / "metrics.csv").write_text("step,metric,value\n", encoding="utf-8")
            package_result = subprocess.run(
                [sys.executable, "-m", "pip", "freeze", "--all"],
                check=True,
                capture_output=True,
                text=True,
            )
            package_text = package_result.stdout.rstrip("\n") + "\n"
            package_file = run_dir / "python-packages.txt"
            package_file.write_text(package_text, encoding="utf-8", newline="\n")
            package_file.chmod(0o640)

            config_record = None
            if args.config is not None:
                source_config = args.config.resolve(strict=True)
                suffix = "".join(source_config.suffixes) or ".config"
                copied_config = run_dir / f"config.resolved{suffix}"
                shutil.copyfile(source_config, copied_config)
                config_record = {
                    "source": str(source_config),
                    "copied": copied_config.name,
                    "sha256": manifest_hash(copied_config),
                }

            environment_payload = {
                "schema_version": 2,
                "run_id": run_id,
                "user": user,
                "started_at_utc": utc_now(),
                "command": args.command,
                "working_directory": str(Path.cwd()),
                "git": state,
                "python": {
                    "executable": os.path.abspath(sys.executable),
                    "version": sys.version.split()[0],
                    "packages_file": package_file.name,
                    "packages_sha256": manifest_hash(package_file),
                    "package_count": len(
                        [line for line in package_text.splitlines() if line.strip()]
                    ),
                },
                "gpus": selected_gpus,
                "config": config_record,
                "manifests": {
                    name: {
                        "path": str(path),
                        "sha256": manifest_hash(path),
                    }
                    for name, path in manifest_paths.items()
                },
            }
            atomic_write_json(run_dir / "environment.json", environment_payload)

            child_environment = os.environ.copy()
            child_environment.update(
                {
                    "PIPER_RUN_ID": run_id,
                    "PIPER_RUN_DIR": str(run_dir),
                    "CUDA_VISIBLE_DEVICES": ",".join(str(gpu["uuid"]) for gpu in selected_gpus),
                    "HF_HUB_OFFLINE": "1",
                    "WANDB_MODE": "offline",
                    "WANDB_DIR": str(run_dir / "wandb"),
                    "TENSORBOARD_LOG_DIR": str(run_dir / "tensorboard"),
                }
            )

            process = subprocess.Popen(args.command, env=child_environment)

            def forward_signal(signum: int, _frame: object) -> None:
                if process.poll() is None:
                    process.send_signal(signum)

            previous_handlers = {
                signum: signal.signal(signum, forward_signal)
                for signum in (signal.SIGINT, signal.SIGTERM)
            }
            try:
                exit_code = process.wait()
            finally:
                for signum, previous in previous_handlers.items():
                    signal.signal(signum, previous)

            summary = {
                "schema_version": 1,
                "run_id": run_id,
                "status": "succeeded" if exit_code == 0 else "failed",
                "exit_code": exit_code,
                "ended_at_utc": utc_now(),
                "environment_file": "environment.json",
                "metrics_jsonl": "metrics.jsonl",
                "metrics_csv": "metrics.csv",
                "python_packages": "python-packages.txt",
                "tensorboard_dir": "tensorboard",
                "wandb_dir": "wandb",
            }
            atomic_write_json(run_dir / "summary.json", summary)
            return exit_code
    except (PiperContainerError, OSError, subprocess.SubprocessError) as exc:
        print(f"piper-gpu-run: {exc}", file=sys.stderr)
        return 3
    finally:
        for stream in lock_streams:
            try:
                fcntl.flock(stream.fileno(), fcntl.LOCK_UN)
            except (OSError, ValueError):
                pass


if __name__ == "__main__":
    raise SystemExit(main())
